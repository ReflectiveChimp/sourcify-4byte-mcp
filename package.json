{
  "name": "sourcify-4byte-mcp",
  "version": "1.0.0",
  "description": "MCP server that decodes EVM function/error/event signatures via the Sourcify 4byte API",
  "type": "module",
  "license": "MIT",
  "author": "ReflectiveChimp",
  "homepage": "https://github.com/ReflectiveChimp/sourcify-4byte-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReflectiveChimp/sourcify-4byte-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ReflectiveChimp/sourcify-4byte-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "evm",
    "ethereum",
    "4byte",
    "sourcify",
    "abi",
    "function-selector",
    "event-topic",
    "claude"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sourcify-4byte-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "node dist/index.js",
    "build": "bun build src/index.ts --production --target node --format esm --packages bundle --env disable --outfile dist/index.js && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4",
    "@types/bun": "^1.3",
    "@types/node": "^25",
    "typescript": "^6.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^3.25"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
